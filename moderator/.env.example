# Moderator env — copy to .env (which is gitignored; never commit secrets)
PORT=3002
UPSTREAM_TTLIVE_URL=http://127.0.0.1:3001
# Generate real secrets:  py -c "import secrets; print(secrets.token_hex(32))"
# a.bat / run.bat run init_env.py, which replaces the placeholders below in
# your .env automatically (the placeholders are public: they authenticate nobody).
# Same API_TOKEN in the bridge .env (TTLIVE_URL points at the moderator).
# MOD_TOKEN guards /overlay/admin + /api/stats + /api/overlay-config.
# (It also guarded the retired /overlay/mod console when MOD_CONSOLE=1.)
API_TOKEN=changeme-generate-with-secrets-token_hex-32
MOD_TOKEN=changeme-generate-with-secrets-token_hex-32
# MOD_CONSOLE=0            # 0 disables /overlay/mod + /api/flags + mod/all feeds
                           # (overlay control panel stays up). Default 1.
# PUBLIC_BASE_URL=https://<your-ngrok-or-domain>   # printed on startup only
# Optional:
# AI_PROVIDER=stub        # stub | off   (perspective/openai later)
# AI_THRESHOLD=0.7
# MAX_HISTORY=50
# BANNED_WORDS=word1,word2   # MERGED with defaults; BANNED_REPLACE=1 to replace
# BANNED_REPLACE=0
# REQUIRE_AUTH=1          # set 0 for local dev without tokens (never tunneled)
# RATE_MAX=60             # max POSTs per RATE_WINDOW seconds per client IP
# RATE_WINDOW=60
# GET_RATE_MAX=300        # max /api/feed polls per 60 s per IP (tunnel shares one IP)
# BODY_LIMIT_KB=256       # max JSON body size for POST endpoints
# FW_TIMEOUT_S=3.0        # upstream forward timeout (0.5-30 s)
# FW_WORKERS=1            # upstream forward threads (1-8; 2-3 for big streams)
# TRUST_PROXY=0           # 1 only if a trusted reverse proxy on this box sanitizes X-Forwarded-For
# NOTE: prefer 127.0.0.1 over localhost — urllib pays ~2 s per call for the
#       Windows IPv6/DNS fallback, which crowds the 3 s forward timeout.
